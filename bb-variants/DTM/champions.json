{
  "variant": "Double Turing Machines (DTM)",
  "conventions": {
    "step_counting": "Rado S convention: halting transition counts as +1 final step (S >= 1).",
    "score_metric": "Sigma: count of nonzero tape symbols upon halting.",
    "indexing": "At step t = 0, 1, 2, ..., active rule is Rules[t % len(rules)], sharing a single state register starting at A (0) and head at 0 on an all-0 tape.",
    "halting": "Halts if the active rule transition is Z/H or ---, OR if current state >= rule.states or current symbol >= rule.symbols."
  },
  "growth_theorem": {
    "statement": "For all n >= 1, m >= 2, a >= 1: BB(n, m) <= DTM(n, m, a) <= BB(a*n, m). In particular for standard 2-rule DTMs: BB(n, m) <= DTM(n, m) <= BB(2n, m).",
    "asymmetric_bound": "For DTM(n, m, a, b), every machine embeds into (n + a, max(m, b)) standard TMs, so DTM(n, m, a, b) <= BB(n + a, max(m, b)).",
    "summary": "Uncomputable; grows at Busy Beaver rank shifted multiplicatively by rule count (a*n states)."
  },
